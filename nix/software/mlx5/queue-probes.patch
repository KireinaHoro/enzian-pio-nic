--- /dev/null
+++ b/drivers/net/mlx5/mlx5_lh.h
@@ -0,0 +1,20 @@
+#ifndef MLX5_LH_INTERNAL_H
+#define MLX5_LH_INTERNAL_H
+#include "rte_pmd_mlx5_lh.h"
+#ifdef LH_MLX5_PROBES
+#include <time.h>
+extern __thread struct rte_pmd_mlx5_lh_sample lh_mlx5_sample;
+static inline uint64_t lh_mlx5_stamp(void) {
+ struct timespec t;
+ __asm__ volatile("" ::: "memory");
+ clock_gettime(CLOCK_MONOTONIC_RAW, &t);
+ __asm__ volatile("" ::: "memory");
+ return (uint64_t)t.tv_sec * 1000000000 + t.tv_nsec;
+}
+#define LH_STAMP(field) (lh_mlx5_sample.field = lh_mlx5_stamp())
+#define LH_COUNT(field, value) (lh_mlx5_sample.field = (value))
+#else
+#define LH_STAMP(field) ((void)0)
+#define LH_COUNT(field, value) ((void)0)
+#endif
+#endif

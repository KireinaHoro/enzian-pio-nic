    register stat_rx_truncated ro addr(base, 0x0710) "STAT_RX_TRUNCATED" type(counter_48b);
    register stat_otn_tx_jabber ro addr(base, 0x0718) "STAT_OTN_TX_JABBER" type(counter_48b);

+impl<Req: RpcEncode, Resp: RpcDecode> Drop for LauberhornRpcEndpoint<Req, Resp> {
+    fn drop(&mut self) {
+        let raw = self.inner.get();
+        let owner = unsafe { (*raw).transport.owner };
+        if !owner.is_null() && unsafe { lauberhorn_rpc_endpoint_destroy(owner, raw) } != 0 {
+            // B4: timeout is not drain. Retain storage on failed destruction.
+            if let Some(address) = self.address.take() { std::mem::forget(address); }
+            if let Some(codec) = self.codec.take() { std::mem::forget(codec); }
+            let replacement = Box::new(UnsafeCell::new(unsafe { std::mem::zeroed() }));
+            std::mem::forget(std::mem::replace(&mut self.inner, replacement));
+            log::error!("nested endpoint remains quarantined until reset");
+        }
+    }
+}

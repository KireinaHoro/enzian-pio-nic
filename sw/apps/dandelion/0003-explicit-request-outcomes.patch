+        let mut buffer = [0xa5u8; 32];
+        assert_eq!(dandelion_marshal::<DandelionRPCRequest>(
+            &request as *const _ as *const c_void, buffer.as_mut_ptr() as *mut c_void,
+            std::mem::size_of_val(&request), 3, std::ptr::null()), -1);
+        assert!(buffer[3..].iter().all(|b| *b == 0xa5));
+        assert_eq!(dandelion_marshal::<DandelionRPCResponse>(
+            &response as *const _ as *const c_void, buffer.as_mut_ptr() as *mut c_void,
+            std::mem::size_of_val(&response), 3, std::ptr::null()), -1);
+        assert!(buffer[3..].iter().all(|b| *b == 0xa5));
+    }
